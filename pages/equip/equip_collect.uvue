<template>
  <scroll-view
      :style="{ flex: 1 }"
      :scroll-with-animation="true"
  >
    <cl-page>
      <cl-topbar
          fixed
          :background-color="isDark? 'black': 'white'"
          :show-back="true"
          safe-area-top
          :height="isMp() ? null : 100"
          :pt="{
    				className: '!z-50'
    			}"
      >
        <view
            class="flex flex-row items-center justify-center p-3 flex-1 w-full"
            :class="{
    					'pt-0': isMp()
    				}"
        >
          <!-- 当前选择展示 -->
          <cl-text
              color="primary"
              :pt="{
						className: '!text-xl ml-2'
					}"
          >
            {{ pageTitle }}
          </cl-text>
        </view>
      </cl-topbar>
      <view class="p-3" v-if="attrConfig.length>0">
        <cl-select-date
            :ref="selectDateRef"
            v-model:values="customDate"
            type="date"
            title=""
            :shortcuts="shortcuts"
            label-format="YYYY-MM-DD"
            value-format="YYYY-MM-DD"
            @range-change="reloadHistory"
            :pt="{className: 'text-2xl h-16'}"
            rangeable></cl-select-date>
        <view class="view-toggle">
          <view
              class="toggle-item"
              :class="{ active: displayMode === 'chart' }"
              @tap="displayMode = 'chart'"
          >
            <cl-icon
                name="bar-chart-2-line"
                :color="displayMode === 'chart' ? 'white' : 'secondary'"
                :pt="{ className: '!text-base' }"
            />
          </view>
          <view
              class="toggle-item"
              :class="{ active: displayMode === 'table' }"
              @tap="displayMode = 'table'"
          >
            <cl-icon
                name="clipboard-line"
                :color="displayMode === 'table' ? 'white' : 'secondary'"
                :pt="{ className: '!text-base' }"
            />
          </view>
        </view>
        <view class="echart-equip-wrap">
          <view v-if="loading" class="echart-loading">
            <cl-loading :pt="{ className: '!text-primary' }"></cl-loading>
            <text class="loading-text">{{ t('加载中...') }}</text>
          </view>
          <view v-if="displayMode === 'chart' && dataDownsampled" class="downsample-hint">{{ t('数据较多已采样展示') }}</view>
          <view v-if="displayMode === 'chart'" class="echart-equip" :style="'height: '+containerSize+'rpx' ">
            <l-echart ref="chartRef" @finished="init" style="width: 100%; height: 100%"></l-echart>
          </view>
          <scroll-view v-else class="table-scroll">
            <view class="aggregate-bar">
              <text class="aggregate-label">{{ t('聚合') }}</text>
              <view class="aggregate-chips">
                <view
                    v-for="opt in aggregateOptions"
                    :key="opt.value === '' ? 'raw' : opt.value"
                    class="aggregate-chip"
                    :class="{ active: aggregateInterval === opt.value }"
                    @tap="onAggregateTap(opt.value)"
                >
                  <text class="aggregate-chip-text">{{ opt.label }}</text>
                </view>
              </view>
            </view>
            <view class="collect-table">
              <view
                  class="table-row"
                  :class="{ 'table-row-last': index === tableRows.length - 1 }"
                  v-for="(row, index) in tableRows"
                  :key="row.time"
              >
                <view class="table-time-row">
                  <text class="time-label">{{ aggregateInterval !== '' ? t('时段开始') : t('时间') }}</text>
                  <text class="time-value">{{ row.time }}</text>
                </view>
                <view class="table-attrs">
                  <view class="table-kv" v-for="item in attrConfig" :key="`${row.time}_${item.name}`">
                    <text class="kv-label">{{ item.name }}</text>
                    <text class="kv-value">{{ formatTableCell(row, item.name) }}</text>
                  </view>
                </view>
              </view>
              <view class="table-empty" v-if="tableData.length <= 0">
                {{ t('暂无数据') }}
              </view>
              <view class="table-more-wrap" v-if="hasMoreTableRows">
                <view class="table-more-btn" @tap="loadMoreTableRows">
                  {{ t('加载更多') }} ({{ tableRows.length }}/{{ tableData.length }})
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="p-3 mt-5" v-if="attrConfig.length<=0">
        <text class="text-gray-400 text-center">-- {{ singleAttrName.length > 0 ? t('该属性暂无历史采集') : t('未对该设备进行数据采集配置') }} --</text>
      </view>
    </cl-page>
  </scroll-view>
</template>

<script setup lang="ts">
import {type ClSelectDateShortcut, dayUts, isDark, isMp} from "@/uni_modules/cool-unix";
import type {EquipCollect, EquipConfig, EquipConfigAttr} from "@/core/types";
import {t} from "@/locale";
import {request} from "@/core/service";
import {apiPath} from "@/core/apiRouter/path";
import {parseData} from "@/core/utils/parse";
import type {LEchartComponentPublicInstance} from "@/uni_modules/lime-echart/components/l-echart/l-echart.uvue";
import {computed, nextTick, ref, watch} from "vue";

const attrConfig = ref<EquipConfigAttr[]>([]);
/** 趋势图：与 portal 一致使用 AUTO 聚合 */
const trendData = ref<EquipCollect[]>([]);
/** 数据表：可选 MIN30 / HOUR / DAY / MONTH 或原始 */
const tableData = ref<EquipCollect[]>([]);
const chartRef = ref<LEchartComponentPublicInstance | null>(null);

const containerSize = ref<number>(800);
const selectDateRef = ref<ClSelectDateComponentPublicInstance | null>(null);
const customDate = ref<string[]>(["", ""]);
const loading = ref<boolean>(false);
const dataDownsampled = ref<boolean>(false);
const displayMode = ref<'chart' | 'table'>('chart');
const tablePage = ref<number>(1);

type AggregateInterval = '' | 'MIN30' | 'HOUR' | 'DAY' | 'MONTH';
const aggregateInterval = ref<AggregateInterval>('');
const aggregateOptions = computed(() => [
  {value: '' as AggregateInterval, label: t('原始数据')},
  {value: 'MIN30' as AggregateInterval, label: t('每30分钟')},
  {value: 'HOUR' as AggregateInterval, label: t('每小时')},
  {value: 'DAY' as AggregateInterval, label: t('每天')},
  {value: 'MONTH' as AggregateInterval, label: t('每月')},
]);

const TABLE_PAGE_SIZE = 50;

/** 表格按时间倒序展示（最新在上），趋势图仍按接口返回顺序 */
const tableRows = computed<EquipCollect[]>(() => {
  const reversed = tableData.value.slice();
  reversed.reverse();
  return reversed.slice(0, tablePage.value * TABLE_PAGE_SIZE);
});

const hasMoreTableRows = computed<boolean>(() => {
  return tableRows.value.length < tableData.value.length;
});

let equipSn: string = ''
let singleAttrName: string = ''

const pageTitle = ref<string>(t('历史曲线'))

/** 每个属性子图在 rpx 上的高度（纵向单列堆叠，与改前 App 一致） */
const singleHeight = 600;

/** 单条折线最大点数，超过则降采样以提升渲染性能 */
const MAX_CHART_POINTS = 400;
/** 时间跨度超过该天数时提示用户可能较慢（仍会加载，仅做降采样展示） */
const LARGE_RANGE_DAYS = 90;

/**
 * 对折线数据做降采样，保留首尾并均匀取点，避免时间跨度大时数据量过多导致卡顿
 */
function downsampleSeriesData<T>(arr: T[], maxPoints: number): T[] {
  if (arr.length <= maxPoints) return arr;
  const result: T[] = [];
  result.push(arr[0]);
  const step = (arr.length - 1) / (maxPoints - 1);
  for (let i = 1; i < maxPoints - 1; i++) {
    const idx = Math.min(Math.round(i * step), arr.length - 1);
    result.push(arr[idx]);
  }
  result.push(arr[arr.length - 1]);
  return result;
}

const shortcuts = ref<ClSelectDateShortcut[]>([
  {
    label: t("今天"),
    value: [
      dayUts().format("YYYY-MM-DD"),
      dayUts().format("YYYY-MM-DD"),
    ],
  },
  {
    label: t("昨日"),
    value: [
      dayUts().subtract(1, "day").format("YYYY-MM-DD"),
      dayUts().subtract(1, "day").format("YYYY-MM-DD"),
    ],
  },
  {
    label: t("本周"),
    value: [
      dayUts().startOf("week").format("YYYY-MM-DD"),
      dayUts().endOf("week").format("YYYY-MM-DD"),
    ],
  },
  {
    label: t("本月"),
    value: [
      dayUts().startOf("month").format("YYYY-MM-DD"),
      dayUts().endOf("month").format("YYYY-MM-DD"),
    ],
  },
]);

const INDUSTRY_THEME = {
  textPrimary: '#1f2937',
  textSecondary: '#6b7280',
  axisLine: '#d1d5db',
  splitLine: '#e5e7eb',

  line: '#3b82f6',
  areaFrom: 'rgba(59,130,246,0.25)',
  areaTo: 'rgba(59,130,246,0.02)',

  tooltipBg: 'rgba(15,23,42,0.9)',
  tooltipBorder: '#334155',
}

function formatTableCell(row: EquipCollect, attrName: string): string {
  const d = row.data;
  if (d == null) return '--';
  const avgKey = `${attrName}_avg`;
  if (d[avgKey] != null && String(d[avgKey]).length > 0) {
    return `${t('均值')} ${d[avgKey]} | ${t('最小')} ${d[`${attrName}_min`]} | ${t('最大')} ${d[`${attrName}_max`]} | ${t('样本')} ${d[`${attrName}_count`]}`;
  }
  const v = d[attrName];
  return v == null || v === '' ? '--' : String(v);
}

async function onAggregateTap(value: AggregateInterval) {
  aggregateInterval.value = value;
  tablePage.value = 1;
  await loadTableData();
}

/** 属性折线图：纵向单列分布（各占 100%/n 高度带），与改版前 App 一致 */
function generateOption() {
  const visualMap: Array<any> = [];
  const xAxis: Array<any> = [];
  const yAxis: Array<any> = [];
  const grid: Array<any> = [];
  const series: Array<any> = [];
  const title: Array<any> = [];

  const single = attrConfig.value.length > 0 ? 100 / attrConfig.value.length : 100;

  attrConfig.value.forEach((item, index) => {
    visualMap.push({
      show: false,
      type: 'continuous',
      seriesIndex: index,
    });

    title.push({
      top: `${single / 15 + single * index}%`,
      left: 'center',
      text: item.name,
      textStyle: {
        fontSize: 12,
        fontWeight: 500,
        color: INDUSTRY_THEME.textPrimary,
      },
    });

    xAxis.push({
      gridIndex: index,
      type: 'time',
      axisLine: {
        lineStyle: {
          color: INDUSTRY_THEME.axisLine,
        },
      },
      axisTick: {show: false},
      splitLine: {
        show: false,
      },
      axisLabel: {
        color: INDUSTRY_THEME.textSecondary,
        fontSize: 11,
        rotate: 30,
      },
    });

    yAxis.push({
      type: 'value',
      axisLine: {
        lineStyle: {
          color: INDUSTRY_THEME.axisLine,
        },
      },
      axisTick: {show: false},
      axisLabel: {
        color: INDUSTRY_THEME.textSecondary,
        fontSize: 11,
      },
      splitLine: {
        show: true,
        lineStyle: {
          color: INDUSTRY_THEME.splitLine,
          type: 'dashed',
        },
      },
      gridIndex: index,
    });

    grid.push({
      top: `${single / 5 + single * index}%`,
      height: `${(single * 3) / 5}%`,
    });

    const vList: Array<[string, string | number]> = [];
    trendData.value.forEach((row) => {
      const d = row.data[item.name];
      if (d != null && d !== '') {
        vList.push([row.time, d]);
      } else {
        vList.push([row.time, '']);
      }
    });
    const sampled = downsampleSeriesData(vList, MAX_CHART_POINTS);
    series.push({
      type: 'line',
      smooth: true,
      showSymbol: false,
      sampling: 'lttb',
      lineStyle: {
        width: 1.5,
        color: INDUSTRY_THEME.line,
      },
      areaStyle: {
        color: INDUSTRY_THEME.line,
        opacity: 0.12,
      },
      data: sampled,
      xAxisIndex: index,
      yAxisIndex: index,
    });
  });

  return {
    visualMap,
    title,
    tooltip: {
      trigger: 'axis',
    },
    xAxis,
    yAxis,
    grid,
    series,
  };
}

function reloadEChart() {
  if (displayMode.value !== 'chart') return;
  if (chartRef.value == null) return;
  const option = generateOption();
  nextTick(() => {
    if (chartRef.value == null) return;
    chartRef.value.setOption(option);
  });
}

async function loadTrendData() {
  if (attrConfig.value.length <= 0) return;
  const res = await request({
    url: apiPath.equip_collect_page as string,
    method: "POST",
    data: {
      sn: equipSn,
      startDate: customDate.value[0] == null ? null : `${customDate.value[0]} 00:00:00`,
      endDate: customDate.value[1] == null ? null : `${customDate.value[1]} 23:59:59`,
      requirePage: false,
      page: 1,
      pageSize: 50000,
      aggregateInterval: 'AUTO',
    },
  });
  if (res === null) {
    trendData.value = [];
    return;
  }
  const r = parseData<EquipCollect[]>(res);
  trendData.value = r == null ? [] : r;
}

async function loadTableData() {
  if (attrConfig.value.length <= 0) return;
  const body: Record<string, unknown> = {
    sn: equipSn,
    startDate: customDate.value[0] == null ? null : `${customDate.value[0]} 00:00:00`,
    endDate: customDate.value[1] == null ? null : `${customDate.value[1]} 23:59:59`,
    requirePage: false,
    page: 1,
    pageSize: 50000,
  };
  if (aggregateInterval.value !== '') {
    body.aggregateInterval = aggregateInterval.value;
  }
  const res = await request({
    url: apiPath.equip_collect_page as string,
    method: "POST",
    data: body,
  });
  if (res === null) {
    tableData.value = [];
    return;
  }
  const r = parseData<EquipCollect[]>(res);
  tableData.value = r == null ? [] : r;
}

async function reloadAllData() {
  if (attrConfig.value.length <= 0) {
    return;
  }
  loading.value = true;
  dataDownsampled.value = false;
  try {
    await Promise.all([loadTrendData(), loadTableData()]);
    dataDownsampled.value = trendData.value.length > MAX_CHART_POINTS;
    tablePage.value = 1;
  } finally {
    loading.value = false;
  }
  reloadEChart();
}

const loadConfig = async () => {
  const res = await request({
    url: apiPath.equip_config as string,
    method: "GET",
    data: {
      equipSn: equipSn,
    },
  });
  if (res === null) {
    return;
  }
  const r = parseData<EquipConfig>(res);
  if (r == null || r.config == null) {
    return;
  }
  if (r.config.attrs == null || r.config.attrs.length <= 0) {
    return;
  }
  let rr = [] as EquipConfigAttr[];
  r.config.attrs.forEach((item) => {
    if (item.needCollect != null && item.needCollect) {
      rr.push(item);
    }
  });
  if (singleAttrName !== '') {
    rr = rr.filter((item) => item.name === singleAttrName);
    pageTitle.value = singleAttrName;
  } else {
    pageTitle.value = t('历史曲线');
  }
  containerSize.value = rr.length * singleHeight;
  attrConfig.value = rr;
  await reloadAllData();
};



function loadMoreTableRows() {
  if (hasMoreTableRows.value === false) return;
  tablePage.value += 1;
}

function reloadHistory(s: string[]) {
  if (s != null && s.length >= 2 && s[0].length > 0 && s[1].length > 0) {
    const start = new Date(s[0]).getTime();
    const end = new Date(s[1]).getTime();
    const days = (end - start) / (24 * 3600 * 1000);
    if (days > LARGE_RANGE_DAYS) {
      uni.showToast({
        title: t('时间跨度较大，已做采样展示'),
        icon: 'none',
        duration: 2500
      });
    }
  }
  void reloadAllData();
}

function formatDateYmd(date: Date | null): string {
  if (date == null) {
    return '';
  }
  const year = date.getFullYear();
  const month = (date.getMonth() + 1).toString().padStart(2, '0');
  const day = date.getDate().toString().padStart(2, '0');
  return `${year}-${month}-${day}`;
}

async function init() {
  if (chartRef.value == null) return
  await chartRef.value.init(null)
  reloadEChart()
}

watch(trendData, () => {
  reloadEChart();
}, {deep: true});

watch(displayMode, (mode: 'chart' | 'table') => {
  if (mode === 'chart') {
    nextTick(() => {
      reloadEChart();
    });
  }
});

onLoad((options) => {
  equipSn = ''
  singleAttrName = ''
  if (options != null) {
    const sn = options.sn as string | null
    if (sn != null) {
      equipSn = sn
    }
  }
  if (options != null) {
    const attr = options.attr as string | null
    if (attr != null) {
      singleAttrName = attr
    }
  }
  if (singleAttrName.length > 0) {
    try {
      const decoded = decodeURIComponent(singleAttrName)
      if (decoded != null) {
        singleAttrName = decoded
      }
    } catch (_) {}
  }
  let current = new Date();
  customDate.value = [formatDateYmd(current), formatDateYmd(current)]
  loadConfig()
})

onShow(() => {
  if (attrConfig.value.length > 0) {
    void reloadAllData()
  }
})
</script>


<style scoped lang="scss">
.echart-equip-wrap {
  position: relative;
  @apply w-full mt-5;
}
.echart-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #64748b;
}
.downsample-hint {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 8rpx 0;
  text-align: center;
}
.echart-equip {
  overflow: hidden;
  @apply bg-white w-full;
}
.view-toggle {
  margin-top: 24rpx;
  margin-left: auto;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  width: 100%;
  border: 1px solid #dbe3ee;
  border-radius: 18rpx;
  padding: 8rpx;
  background: #f3f6fb;
}
.toggle-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  border-radius: 10rpx;
  background: transparent;
}
.toggle-item.active {
  background: #1ea9f7;
}
.table-scroll {
  margin-top: 20rpx;
}
.collect-table {
  display: flex;
  flex-direction: column;
  border: 1px solid #e2e8f0;
  border-radius: 12rpx;
  overflow: hidden;
}
.table-row {
  background: #ffffff;
  border-bottom: 1px solid #eef2f7;
  padding: 14rpx 16rpx;
}
.table-row-last {
  border-bottom: 0;
}
.table-time-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10rpx;
  border-bottom: 1px dashed #e2e8f0;
}
.time-label {
  color: #64748b;
  font-size: 22rpx;
  text-align: left;
  flex: 1;
}
.time-value {
  flex: 1;
  color: #0f172a;
  font-size: 23rpx;
  text-align: right;
}
.table-attrs {
  margin-top: 8rpx;
}
.table-kv {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  width: 100%;
}
.kv-label {
  font-size: 23rpx;
  color: #64748b;
  padding-right: 12rpx;
  flex: 1;
  text-align: left;
}
.kv-value {
  font-size: 24rpx;
  color: #334155;
  min-width: 120rpx;
  flex: 1;
  text-align: right;
  word-break: break-all;
}
.table-empty {
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.table-more-wrap {
  padding: 18rpx 16rpx 24rpx;
  display: flex;
  justify-content: center;
}
.table-more-btn {
  min-width: 220rpx;
  text-align: center;
  color: #2563eb;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
}
.aggregate-bar {
  margin-bottom: 16rpx;
  padding: 12rpx 0 4rpx;
}
.aggregate-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
}
.aggregate-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}
.aggregate-chip {
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  border: 1px solid #dbe3ee;
  background: #f8fafc;
}
.aggregate-chip.active {
  background: #1ea9f7;
  border-color: #1ea9f7;
}
.aggregate-chip-text {
  font-size: 22rpx;
  color: #334155;
}
.aggregate-chip.active .aggregate-chip-text {
  color: #ffffff;
}
</style>
